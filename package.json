    "marked": "^18.0.7",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
